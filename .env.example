# Google Places — discovery (lead_finder.py)
GOOGLE_API_KEY=

# Anthropic — reply triage, opener drafting, weekly report (claude_tasks.py)
ANTHROPIC_API_KEY=

# Mail provider server token (sender.py; Postmark-shaped API)
MAIL_PROVIDER_TOKEN=

# Domain outbound mail is sent from. Replies come back to
# reply+<lead_id>@<this domain>, which is how webhook.py attributes them.
MAIL_FROM_DOMAIN=

# Shared secret the provider must echo in the X-Webhook-Secret header.
# Unset means webhook.py rejects everything (fail closed).
WEBHOOK_SECRET=

# What you sell — injected into the triage/opener/report prompts
# (claude_tasks.py). e.g. "web design", "SEO", "bookkeeping"
LEADPIPE_SERVICE=web design

