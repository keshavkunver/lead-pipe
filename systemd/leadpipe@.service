# Templated job runner: %i is the orchestrator job name
# (leadpipe@discover, leadpipe@triage, leadpipe@report).
[Unit]
Description=leadpipe %i job
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=leadpipe
WorkingDirectory=/opt/leadpipe
EnvironmentFile=/opt/leadpipe/.env
ExecStart=/opt/leadpipe/venv/bin/python orchestrator.py %i
# stdout/stderr go to the journal: journalctl -u leadpipe@discover
